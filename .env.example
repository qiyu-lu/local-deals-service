# Copy this file to .env for local development.
# Do not commit real passwords or machine-specific credentials.

LOCAL_DEALS_DATASOURCE_URL=jdbc:mysql://localhost:3306/local_deals?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
LOCAL_DEALS_DATASOURCE_USERNAME=root
LOCAL_DEALS_DATASOURCE_PASSWORD=change-me

LOCAL_DEALS_REDIS_HOST=localhost
LOCAL_DEALS_REDIS_PORT=6379
LOCAL_DEALS_REDIS_PASSWORD=change-me
LOCAL_DEALS_REDIS_COMMAND_TIMEOUT=500ms
LOCAL_DEALS_REDIS_POOL_MAX_WAIT=500ms

# Bounded cache TTLs. Empty values must not outlive the corresponding positive values.
LOCAL_DEALS_CACHE_SHOP_DETAIL_TTL=30s
LOCAL_DEALS_CACHE_SHOP_DETAIL_EMPTY_TTL=30s
LOCAL_DEALS_CACHE_SHOP_TYPE_TTL=100m
LOCAL_DEALS_CACHE_SHOP_TYPE_EMPTY_TTL=30s

# Local-only authentication diagnostics. Keep false outside an isolated workstation.
LOCAL_DEALS_LOG_VERIFICATION_CODE=false

# Upload limits and storage root.
LOCAL_DEALS_IMAGE_UPLOAD_DIR=./frontend/user/imgs
LOCAL_DEALS_MAX_IMAGE_SIZE=5MB
LOCAL_DEALS_MAX_UPLOAD_REQUEST_SIZE=6MB

# Create-only platform administrator bootstrap. There is no default credential.
# Configure these only for the first new-version startup, use a unique password, then remove
# them from the runtime environment after the platform account has been created and verified.
LOCAL_DEALS_ADMIN_BOOTSTRAP_USERNAME=
LOCAL_DEALS_ADMIN_BOOTSTRAP_PASSWORD=
LOCAL_DEALS_ADMIN_BOOTSTRAP_DISPLAY_NAME=平台管理员

# Independent admin session and login throttling. Consumer SMS tokens cannot enter /admin/**.
LOCAL_DEALS_ADMIN_SESSION_TTL=30m
LOCAL_DEALS_ADMIN_MAX_LOGIN_FAILURES=5
LOCAL_DEALS_ADMIN_MAX_IP_LOGIN_ATTEMPTS=30
LOCAL_DEALS_ADMIN_LOGIN_LOCK_DURATION=15m
# The bundled docker-compose pins nginx to 172.30.55.10. If that subnet conflicts locally,
# change docker-compose.yml and this value together. Production must use its exact proxy IP/CIDR.
LOCAL_DEALS_ADMIN_TRUSTED_PROXIES=172.30.55.10

# WebSocket origin boundary.
LOCAL_DEALS_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5173

# Derived hot-rank rollout: build and compare with MySQL before enabling cache reads.
LOCAL_DEALS_BLOG_HOT_RANK_READ_ENABLED=false
LOCAL_DEALS_BLOG_HOT_RANK_REFRESH_ENABLED=false
LOCAL_DEALS_BLOG_HOT_RANK_TOP_K=1000
LOCAL_DEALS_BLOG_HOT_RANK_PAGE_SIZE=10
LOCAL_DEALS_BLOG_HOT_RANK_INITIAL_DELAY=10s
LOCAL_DEALS_BLOG_HOT_RANK_FIXED_DELAY=30s
LOCAL_DEALS_BLOG_HOT_RANK_MAX_STALE=2m

# Durable blog-like outbox. Fail closed until the stop-old-nodes/import audit is complete.
LOCAL_DEALS_BLOG_LIKE_WRITE_ENABLED=false
LOCAL_DEALS_BLOG_LIKE_WORKER_ENABLED=false
LOCAL_DEALS_BLOG_LIKE_INITIAL_DELAY=5s
LOCAL_DEALS_BLOG_LIKE_FIXED_DELAY=200ms
LOCAL_DEALS_BLOG_LIKE_BATCH_SIZE=500
LOCAL_DEALS_BLOG_LIKE_PROCESSED_RETENTION=1d
LOCAL_DEALS_BLOG_LIKE_CLEANUP_FIXED_DELAY=1s
LOCAL_DEALS_BLOG_LIKE_CLEANUP_BATCH_SIZE=2000
LOCAL_DEALS_BLOG_LIKE_CLEANUP_MAX_BATCHES=5
# One-startup migration gate. It requires both WRITE_ENABLED and WORKER_ENABLED to be false.
LOCAL_DEALS_BLOG_LIKE_LEGACY_BACKFILL_ON_STARTUP=false
LOCAL_DEALS_BLOG_LIKE_LEGACY_SCAN_COUNT=500
LOCAL_DEALS_BLOG_LIKE_LEGACY_BATCH_SIZE=500

# Stale seckill PROCESSING recovery has three independent rollout gates.
# Keep every gate false until the stop-write/backfill/observe checklist in
# docs/seckill-reconciliation.md has been completed. In particular, never enable automatic
# compensation merely because reconciliation reads have been enabled.
LOCAL_DEALS_SECKILL_RECONCILIATION_ENABLED=false
LOCAL_DEALS_SECKILL_COMPENSATION_ENABLED=false
LOCAL_DEALS_SECKILL_BACKFILL_ON_STARTUP=false
LOCAL_DEALS_SECKILL_RECONCILIATION_INITIAL_DELAY=30s
LOCAL_DEALS_SECKILL_RECONCILIATION_FIXED_DELAY=10s
LOCAL_DEALS_SECKILL_RECONCILIATION_STALE_AFTER=2m
LOCAL_DEALS_SECKILL_RECONCILIATION_RETRY_DELAY=1m
# This is an explicit business failure SLA, not proof that Broker delivery has ended. Before
# enabling compensation, choose and record it from business tolerance and observed consume P99;
# late MQ deliveries are rejected by the exact FAILED state gate.
LOCAL_DEALS_SECKILL_RECONCILIATION_FINAL_TIMEOUT=15m
LOCAL_DEALS_SECKILL_RECONCILIATION_BATCH_SIZE=100
LOCAL_DEALS_SECKILL_BACKFILL_SCAN_COUNT=500

# Only needed when using docker-compose to start MySQL/Redis.
MYSQL_ROOT_PASSWORD=change-me

# Optional benchmark overrides.
# The benchmark scripts read MYSQL_HOST/REDIS_HOST from LOCAL_DEALS_* above by default.
# Override here only if your benchmark target differs from the application datasource.
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# REDIS_HOST=localhost
# REDIS_PORT=6379
MYSQL_DATABASE=local_deals
# Loopback-only management plane. Containers must override the address only on an internal
# monitoring network and must not publish this port to the public host interface.
LOCAL_DEALS_MANAGEMENT_PORT=18084
LOCAL_DEALS_MANAGEMENT_ADDRESS=127.0.0.1
LOCAL_DEALS_OBSERVABILITY_SAMPLING_ENABLED=false
LOCAL_DEALS_OBSERVABILITY_INITIAL_DELAY=10s
LOCAL_DEALS_OBSERVABILITY_SAMPLING_INTERVAL=30s
